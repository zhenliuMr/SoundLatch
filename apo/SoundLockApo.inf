; SoundLockApo.inf - driver package for the in-engine SoundLock APO
; Class AudioProcessingObject is mandatory for Windows 11 21H2+ (build 22000+).
[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %Provider%
CatalogFile = SoundLockApo.cat
DriverVer   = 10/19/2026,2.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[Manufacturer]
%Provider% = SoundLock, NTamd64

[SoundLock.NTamd64]
%DeviceDesc% = SoundLockApo_Install, ROOT\AudioProcessingObject\SoundLockApo

[SoundLockApo_Install.NT]
CopyFiles = SoundLockApo_Copy
AddReg    = SoundLockApo_Reg

[SoundLockApo_Copy]
SoundLockApo.dll

[SoundLockApo_Reg]
HKCR,CLSID\{A5C6D1E0-3B7F-4C21-9E44-9E1D2C0A7781},,,"SoundLock APO"
HKCR,CLSID\{A5C6D1E0-3B7F-4C21-9E44-9E1D2C0A7781}\InprocServer32,,,%%SystemRoot%%\System32\SoundLockApo.dll
HKCR,CLSID\{A5C6D1E0-3B7F-4C21-9E44-9E1D2C0A7781}\InprocServer32,ThreadingModel,,"Both"

[SoundLockApo_Install.NT.Services]
AddService = ,2

[Strings]
Provider   = "SoundLock"
DeviceDesc = "SoundLock APO (engine-in audio processor)"
